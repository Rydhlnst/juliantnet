# Neon PostgreSQL (use the pooled URL for Vercel runtime)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Optional: unpooled URL for local/CI migrations
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Better Auth
BETTER_AUTH_SECRET=replace-with-a-random-32-character-minimum-secret
BETTER_AUTH_URL=https://internetcepat.co.id

# Public site
NEXT_PUBLIC_SITE_URL=https://internetcepat.co.id
NEXT_PUBLIC_BASE_URL=https://internetcepat.co.id
NEXT_PUBLIC_WHATSAPP_NUMBER=6280000000000

# Cloudflare R2 media (required for CMS uploads)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://your-r2-public-domain.example.com

# One-time local admin seed only; do not keep in Vercel after seeding
SEED_ADMIN_NAME=Admin Internet Cepat
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
